# Single config — edit here only. Bash expands ${} when sourced.
# Docker tag should match FASTVEP_REF_RELEASE.

FASTVEP_REF_RELEASE=grch38-r115

# Default: container. Host scripts: export FASTVEP_REFERENCE_DIR=$PWD/reference before sourcing.
FASTVEP_REFERENCE_DIR=${FASTVEP_REFERENCE_DIR:-/opt/fastvep/reference}

GFF3=${FASTVEP_REFERENCE_DIR}/Homo_sapiens.GRCh38.115.gff3
FASTA=${FASTVEP_REFERENCE_DIR}/GRCh38_no_alt.new.fa
FASTA_FAI=${FASTVEP_REFERENCE_DIR}/GRCh38_no_alt.new.fa.fai
TRANSCRIPT_CACHE=${FASTVEP_REFERENCE_DIR}/Homo_sapiens.GRCh38.115.gff3.fastvep.cache

FASTVEP_HGVS=1
