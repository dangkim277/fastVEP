# Single config — edit here only. Bash expands ${} when sourced.
# Docker tag should match FASTVEP_REF_RELEASE.

FASTVEP_REF_RELEASE=grch38-r115

# Default: container. Host scripts: export FASTVEP_REFERENCE_DIR=$PWD/reference before sourcing.
FASTVEP_REFERENCE_DIR=${FASTVEP_REFERENCE_DIR:-/opt/fastvep/reference}

# Ensembl (.gff3) + RefSeq (.gff) — merged cache (VEP --merged style).
GFF3_ENSEMBL=${FASTVEP_REFERENCE_DIR}/Homo_sapiens.GRCh38.115.gff3
GFF3_REFSEQ=${FASTVEP_REFERENCE_DIR}/GCF_000001405.40_GRCh38.p14_genomic.gff
GFF3=${GFF3_ENSEMBL}

FASTA=${FASTVEP_REFERENCE_DIR}/Homo_sapiens.GRCh38.dna.primary_assembly.fa
FASTA_FAI=${FASTVEP_REFERENCE_DIR}/Homo_sapiens.GRCh38.dna.primary_assembly.fa.fai
TRANSCRIPT_CACHE=${FASTVEP_REFERENCE_DIR}/GRCh38.merged.fastvep.cache

FASTVEP_HGVS=1
